# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# --- Required: get these from the provider dashboards ---
TAVILY_API_KEY=your_tavily_key_here
NVIDIA_API_KEY=your_nvidia_key_here

# --- App environment ---
# "development" or "production". In production: session cookies are marked
# Secure (HTTPS-only) and the app refuses to boot without valid API keys
# instead of just logging an error.
APP_ENV=development

# Signs the anonymous session cookie that keeps each visitor's reports
# private. Leave blank in development (a random key is generated on every
# restart - fine locally, but it logs everyone out on each restart). Set a
# real fixed value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: require an "X-API-Key" header on all research/chat endpoints -
# e.g. give one shared code to a class of students. Leave blank for fully
# open access (no gate).
SAAS_ACCESS_KEY=

# Comma-separated list of extra origins allowed to call this API with
# credentials from another domain (only needed if you build a separate
# frontend elsewhere). Leave blank for normal same-origin browser use.
ALLOWED_ORIGINS=

# --- Rate limits (per client IP) ---
RATE_LIMIT_RESEARCH=6/hour
RATE_LIMIT_CHAT=40/hour
RATE_LIMIT_TTS=300/hour

# --- Search & scrape tuning ---
TAVILY_SEARCH_DEPTH=basic
SEARCH_MAX_RESULTS=16
SEARCH_TIMEOUT=15
SCRAPE_TARGET_SUCCESS=8
SCRAPE_TIMEOUT=8
SCRAPE_MAX_WORKERS=16
SCRAPE_CHAR_LIMIT=6000
REPORT_CONTEXT_CHAR_LIMIT=10000

# Uploaded PDFs longer than this only have their first N pages processed -
# this app is built for reports/articles, not whole books.
MAX_PDF_PAGES=40
MAX_UPLOAD_MB=15

# --- LLM model routing ---
MODEL_FAST=meta/llama-3.1-8b-instruct
MODEL_QUALITY=meta/llama-3.1-70b-instruct
NVIDIA_API_TIMEOUT=80

# --- Caching (search results only, see utils/cache.py) ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=21600

# --- Report ---
# "flash"      = superfast, ~900-1100 words, 8B model only
# "assignment" = fast, ~2800-3200 words, tuned for college assignments (default)
# "deep"       = exhaustive, ~3800-4800 words, slower
DEFAULT_REPORT_MODE=assignment

# --- Supabase (optional) - persistent report history across redeploys ---
# Local disk (reports/<session>/...) works fine for a single long-lived
# server, but most PaaS hosts (Render included) wipe the filesystem on every
# redeploy. Set these two to also persist every report to Supabase, so
# history survives redeploys. Leave both blank to keep using local-disk-only
# storage - nothing else changes. See README.md "Supabase setup" for the SQL
# to run once in your Supabase project.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=reports

# --- Text-to-speech (on by default, no API key needed) - for the Podcast tool ---
# The browser's built-in voice works with zero setup but sounds robotic on
# most devices. By default, the podcast player instead uses Microsoft Edge's
# free neural voices (via the open-source `edge-tts` library) - no account,
# no key, no cost. It automatically falls back to the browser voice if this
# ever fails, so nothing breaks either way. Set TTS_ENABLED=false to skip it
# and always use the browser voice. The player has an in-app accent selector
# (American / Indian) - these are just the underlying voice IDs for each.
TTS_ENABLED=true
DEFAULT_TTS_ACCENT=american
TTS_US_MALE_VOICE=en-US-GuyNeural
TTS_US_FEMALE_VOICE=en-US-AriaNeural
TTS_IN_MALE_VOICE=en-IN-PrabhatNeural
TTS_IN_FEMALE_VOICE=en-IN-NeerjaNeural

LOG_LEVEL=INFO
PORT=8000
